{
  "name": "big-netwatch",
  "productName": "BIG NetWatch",
  "version": "0.1.0",
  "description": "Real-time network and broadcast-equipment monitor for Brookline Interactive Group (UniFi + Blackmagic)",
  "author": "Brookline Interactive Group",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "serve": "node server/server.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.brooklineinteractive.netwatch",
    "productName": "BIG NetWatch",
    "artifactName": "BIG-NetWatch-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "server/**",
      "ui/**",
      "config.json",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BIG-NetWatch-${version}-win-setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "amateurmenace",
      "repo": "big-netwatch",
      "releaseType": "release"
    },
    "portable": {
      "artifactName": "BIG-NetWatch-${version}-win-portable.${ext}"
    },
    "dmg": {
      "artifactName": "BIG-NetWatch-${version}-mac.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/amateurmenace/big-netwatch.git"
  }
}
